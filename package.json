{
  "name": "gxqs-platform",
  "version": "0.1.0",
  "private": true,
  "description": "GXQS Distributed Compute Operating Platform – unified control plane for wallet, mining, validation, and deployment",
  "repository": {
    "type": "git",
    "url": "https://github.com/GXQS/Wallet.git"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "audit": "pnpm audit --audit-level=moderate --ignore GHSA-34x7-hfp2-rc4v --ignore GHSA-8qq5-rm4j-mr97 --ignore GHSA-83g3-92jg-28cx --ignore GHSA-qffp-2rhf-9h96 --ignore GHSA-9ppj-qmqm-q256 --ignore GHSA-r6q2-hw4h-h46w",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@changesets/cli": "^2.29.4",
    "lefthook": "^1.11.13",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "react": "18.3.1",
      "react-dom": "18.3.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-34x7-hfp2-rc4v",
        "GHSA-8qq5-rm4j-mr97",
        "GHSA-83g3-92jg-28cx",
        "GHSA-qffp-2rhf-9h96",
        "GHSA-9ppj-qmqm-q256",
        "GHSA-r6q2-hw4h-h46w"
      ]
    }
  }
}
